# ─── Supabase (get these from supabase.com → project → Settings → API) ───────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # use service key, NOT anon key

# ─── Frontend (Vite needs VITE_ prefix) ──────────────────────────────────────
# Since frontend and backend are on same Vercel domain, just use /api
VITE_API_URL=/api
